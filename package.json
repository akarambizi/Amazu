{
    "name": "amazu",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@10.17.1",
    "description": "Shared repo-level tooling for Amazu (client + server are independent pnpm projects).",
    "scripts": {
        "prepare": "husky",
        "lint": "pnpm --dir client lint && pnpm --dir server lint",
        "lint:fix": "pnpm --dir client lint:fix && pnpm --dir server lint:fix"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^5.62.0",
        "@typescript-eslint/parser": "^5.62.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^8.10.2",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^27.9.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^4.2.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^4.6.2",
        "husky": "^9.1.7",
        "lint-staged": "^15.5.0",
        "prettier": "^2.8.8",
        "typescript": "^5.9.3"
    },
    "lint-staged": {
        "client/**/*.{js,jsx,ts,tsx,css,md}": [
            "prettier --write",
            "eslint --fix --ext .js,.jsx,.ts,.tsx"
        ],
        "server/**/*.ts": [
            "prettier --write",
            "eslint --fix --ext .ts"
        ]
    }
}
