# Copy this file to .env and adjust values for your environment.
# .env itself is gitignored (see root .gitignore's `*.env` pattern).

# Port the Express server listens on.
PORT=5000

# Whether the app is running inside the docker-compose network (affects which Mongo/
# Zipkin host names are used — see src/utils/environment.ts).
DOCKER_ENV=false

# MongoDB connection strings. Only one is used at a time, selected by DOCKER_ENV.
MONGO_URI_LOCAL=mongodb://localhost:27017/Amazu
MONGO_URI_DOCKER=mongodb://mongo:27017/Amazu

# Comma-separated list of allowed CORS origins, e.g. https://amazu.app,https://admin.amazu.app
# Leave unset for local development to allow all origins.
CORS_ORIGINS=

# Rate limiting (express-rate-limit), applied to all routes.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Placeholder for the future authentication feature (specs/001-authentication).
# Generate a strong random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=
