{
    "name": "amazu-client",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.17.1",
    "dependencies": {
        "axios": "^1.20.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-query": "^3.39.3",
        "react-router-dom": "^6.30.6",
        "styled-components": "^5.3.11",
        "web-vitals": "^2.1.4"
    },
    "scripts": {
        "dev": "VITE_API_ENV=dev concurrently \"pnpm start\" \"pnpm server\"",
        "dev:mock": "VITE_API_ENV=mock concurrently \"pnpm start\" \"pnpm mock-server\"",
        "start": "vite",
        "server": "cd ../server && pnpm run serve",
        "mock-server": "json-server --watch src/mock-server/index.cjs --port 4200",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "test": "vitest run --coverage",
        "test:watch": "vitest",
        "lint": "eslint src --ext js,jsx,ts,tsx",
        "lint:fix": "eslint src --ext js,jsx,ts,tsx --fix",
        "prettier-format": "prettier --config .prettierrc 'src/**/*.tsx' --write"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "^14.3.1",
        "@testing-library/user-event": "^14.6.8",
        "@types/express": "^4.17.17",
        "@types/node": "^20.19.43",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@types/styled-components": "^5.1.36",
        "@vitejs/plugin-react": "^5.2.0",
        "@vitest/coverage-v8": "^2.1.9",
        "concurrently": "^8.2.2",
        "eslint": "^8.57.1",
        "jsdom": "^25.0.1",
        "json-server": "^0.17.4",
        "typescript": "^5.9.3",
        "vite": "^5.4.21",
        "vite-plugin-svgr": "^5.2.0",
        "vitest": "^2.1.9"
    }
}
